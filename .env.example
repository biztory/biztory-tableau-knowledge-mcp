# Copy to .env and fill in, or set these in your MCP client's "env" block.
# Tableau Knowledge is a Tableau Cloud feature (Tableau+ license, September 2026 and later).

# --- Required: your Tableau Cloud site ---
# https://<pod>.online.tableau.com   (pod = the prefix in your browser URL, e.g. 10ax)
TABLEAU_SERVER=https://10ax.online.tableau.com

# Site content URL (the slug in /#/site/<contentUrl>/...).
TABLEAU_SITE_CONTENT_URL=YourSite

# --- Auth: a Personal Access Token ---
# Create one under your Tableau account settings. The secret is ONE string, do not split it.
# Any role can read; writing semantic contexts needs the Creator role.
TABLEAU_PAT_NAME=my-token-name
TABLEAU_PAT_SECRET=the-full-secret-string

# --- Optional ---
# TABLEAU_KNOWLEDGE_GRAPH_ID=       # default graph for every tool; empty = the site's primary graph
# TABLEAU_TIMEOUT=60
# TABLEAU_API_VERSION=3.30          # REST version used for sign-in; else auto-detected
# TABLEAU_ALLOW_HTTP=1              # only for a plain-http server on a trusted internal network
# TABLEAU_LOG_LEVEL=INFO            # DEBUG logs each HTTP call (method + URL only) to stderr

# --- Advanced: a pre-obtained X-Tableau-Auth session token instead of a PAT ---
# TABLEAU_AUTH_TOKEN=
